# AI-Proxy Master 配置
# 代理后端设置
PROXY_HOST=0.0.0.0
PROXY_PORT=8000
MASTER_KEY=sk-admin-123456
AUTH_ENABLED=true

# 管理后台设置
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8501

# 上游请求策略（快速失败）
KEY_STRATEGY=sticky_failover
KEY_RATE_LIMIT_COOLDOWN_SEC=180
UPSTREAM_TIMEOUT_SEC=360
REQUEST_TOTAL_TIMEOUT_SEC=720
UPSTREAM_MAX_RETRIES=0

#日志相关
LOG_FILE_ENABLED=false
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_DIR=./logs
LOG_FILE_NAME=proxy.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=7

# 速率限制（0 = 不限制）
RATE_LIMIT_PER_MINUTE=0

# 管理面板密码（空 = 不需要密码）
ADMIN_PASSWORD=


# Google Vertex AI（取消注释并填写配置即可使用）
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/service-account.json
# VERTEXAI_PROJECT=
# VERTEXAI_LOCATION=us-central1

# AWS Bedrock（取消注释并填写配置即可使用）
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
