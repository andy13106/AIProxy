PROXY_HOST=0.0.0.0
PROXY_PORT=8000
PROXY_WORKERS=1
MASTER_KEY=change-this-master-key
AUTH_ENABLED=true

ADMIN_HOST=0.0.0.0
ADMIN_PORT=8501
ADMIN_PASSWORD=change-this-admin-password

KEY_STRATEGY=sticky_failover
KEY_RATE_LIMIT_COOLDOWN_SEC=180
UPSTREAM_TIMEOUT_SEC=360
REQUEST_TOTAL_TIMEOUT_SEC=720
ALLOW_CLIENT_TIMEOUT_OVERRIDE=false
UPSTREAM_MAX_RETRIES=1
STREAM_HEARTBEAT_SEC=15

# ==============================
# Google Vertex AI 配置（OAuth / Service Account 认证）
# ==============================
# 使用 Vertex AI 时无需 API Key，通过 Google Cloud Service Account 认证
# 1. 在 GCP Console 创建项目并启用 Vertex AI API
# 2. 创建 Service Account 并下载 JSON 密钥文件
# 3. 将密钥文件放到 credentials/ 目录下
# 4. 取消下面的注释并填写配置
#
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/service-account.json
# VERTEXAI_PROJECT=your-gcp-project-id
# VERTEXAI_LOCATION=us-central1
#
# 在管理面板中添加 Provider 时：
#   - provider_type: vertex_ai
#   - api_base: 留空
#   - API Key: 填任意占位符（不会实际使用）
#
# 支持的模型示例：
#   gemini-2.0-flash, gemini-2.5-pro, gemini-2.5-flash 等
# ==============================

# ==============================
# AWS Bedrock 配置（IAM 认证）
# ==============================
# 使用 Bedrock 时无需 API Key，通过 AWS IAM 认证
#
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=us-east-1
#
# 在管理面板中添加 Provider 时：
#   - provider_type: bedrock
#   - api_base: 留空
#   - API Key: 填任意占位符（不会实际使用）
# ==============================

# ==============================
# Docker 部署说明
# ==============================
#
# 🚀 一键启动脚本（推荐）
#
#   macOS/Linux:
#     chmod +x start-docker.sh
#     ./start-docker.sh
#
#   Windows:
#     CMD:       start-docker.bat
#     PowerShell: .\start-docker.ps1
#
#   脚本功能:
#   - 自动检测并安装 Docker
#   - 自动启动 Docker 服务
#   - 自动创建 .env 配置文件
#   - 一键启动 AIProxy 服务
#
# =================================
#
# 手动部署方式：
#   1. 复制此文件为 .env 并修改配置
#   2. 执行: docker compose up -d --build
#   3. 访问:
#      - 代理接口: http://localhost:8000
#      - 管理面板: http://localhost:8501
#
# 常用命令:
#   - 查看日志: docker compose logs -f
#   - 重启服务: docker compose restart
#   - 停止服务: docker compose down
#
# 数据持久化:
#   - 数据库文件保存在 ./data 目录
#   - 重建容器不会丢失配置和使用记录
# ==============================
