PROXY_HOST=0.0.0.0
PROXY_PORT=8000
MASTER_KEY=sk-admin-123456
AUTH_ENABLED=true

ADMIN_HOST=0.0.0.0
ADMIN_PORT=8501

KEY_RATE_LIMIT_COOLDOWN_SEC=60
UPSTREAM_TIMEOUT_SEC=120
STREAM_HEARTBEAT_SEC=15

# ==============================
# Docker 部署说明
# ==============================
#
# 🚀 一键启动脚本（推荐）
#
#   macOS/Linux:
#     chmod +x start-docker.sh
#     ./start-docker.sh
#
#   Windows:
#     CMD:       start-docker.bat
#     PowerShell: .\start-docker.ps1
#
#   脚本功能:
#   - 自动检测并安装 Docker
#   - 自动启动 Docker 服务
#   - 自动创建 .env 配置文件
#   - 一键启动 AIProxy 服务
#
# =================================
#
# 手动部署方式：
#   1. 复制此文件为 .env 并修改配置
#   2. 执行: docker compose up -d --build
#   3. 访问:
#      - 代理接口: http://localhost:8000
#      - 管理面板: http://localhost:8501
#
# 常用命令:
#   - 查看日志: docker compose logs -f
#   - 重启服务: docker compose restart
#   - 停止服务: docker compose down
#
# 数据持久化:
#   - 数据库文件保存在 ./data 目录
#   - 重建容器不会丢失配置和使用记录
# ==============================
